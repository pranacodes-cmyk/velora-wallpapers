<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_alarm_card"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:background="@drawable/prayer_alarm_notification_card"
    android:clipToPadding="false"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="14dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/prayer_alarm_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="Morning Prayer"
            android:textColor="#FFF8E6"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/prayer_alarm_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="12:15"
            android:textColor="#E8C56B"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/prayer_alarm_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:text="Your prayer bell is ringing"
        android:textColor="#C9D2E8"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/prayer_alarm_close"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/prayer_alarm_notification_button_outline"
            android:gravity="center"
            android:text="Close"
            android:textColor="#F6E7B8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/prayer_alarm_pray"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/prayer_alarm_notification_button_fill"
            android:gravity="center"
            android:text="Pray Now"
            android:textColor="#10182F"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>