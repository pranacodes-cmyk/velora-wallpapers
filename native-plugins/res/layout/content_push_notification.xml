<?xml version="1.0" encoding="utf-8"?>
<!--
  Prayly content push notification.

  Rendered inside DecoratedCustomViewStyle — the OS header (app icon,
  "Prayly", timestamp) sits ABOVE this card. Never add another brand
  chip inside or it nests.

  Height is wrap_content with generous vertical padding so title + body
  + buttons all breathe; nothing is clipped on Samsung One UI / Pixel /
  MIUI heads-up frames.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content_push_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/content_push_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- Hidden anchors so RemoteViews.setTextViewText / setImageViewResource
         calls in ContentPushReceiver remain no-op safe across builds. -->
    <ImageView
        android:id="@+id/content_push_glyph"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/content_push_kind"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/content_push_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="Today's verse is ready"
        android:textColor="#FFF8E6"
        android:textSize="15sp"
        android:textStyle="bold"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/content_push_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="A word from God to start your day."
        android:textColor="#C9D2E8"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/content_push_close"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/prayer_alarm_notification_button_outline"
            android:gravity="center"
            android:text="Close"
            android:textColor="#F6E7B8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/content_push_cta"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/content_push_cta"
            android:gravity="center"
            android:text="Open"
            android:textColor="#10182F"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
